{
  "permissions": {
    "defaultMode": "acceptEdits",
    "additionalDirectories": [],
    "allow": [
      "Bash(npm run *)",
      "Bash(npm install)",
      "Bash(npm ci)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(pip install *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout *)",
      "Bash(git branch *)",
      "Bash(git pull *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(echo *)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -rf /)",
      "Bash(sudo *)",
      "Bash(git push * --force *)",
      "Bash(git push * -f *)",
      "Bash(git push *origin main*)",
      "Bash(git push *origin master*)",
      "Bash(git reset --hard *)",
      "Bash(curl * | sh)",
      "Bash(curl * | bash)",
      "Bash(wget * | sh)",
      "Bash(chmod -R *)",
      "Bash(:(){ *)",
      "Read(/etc/**)",
      "Read(~/.ssh/**)",
      "Read(**/.env)",
      "Read(**/*.pem)"
    ]
  }
}
