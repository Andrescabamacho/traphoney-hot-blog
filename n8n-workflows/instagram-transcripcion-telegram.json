      },
      "id": "00000000-0000-0000-0000-000000000014",
      "name": "Error: Transcripción fallida",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1980, 420],
      "credentials": {
        "telegramApi": {
          "id": "1",
          "name": "CronistaYT Bot"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const transcription = $input.first().json?.text || '';\n\nif (!transcription.trim()) {\n  throw new Error('Transcripción vacía');\n}\n\n// Telegram message limit is 4096 chars; we split if needed\nconst MAX_CHUNK = 3800;\nconst header = '📝 *Transcripción del video de Instagram:*\\n\\n';\nconst footer = '\\n\\n_Transcrito con Whisper AI_ 🤖';\n\nconst full = header + transcription + footer;\n\nif (full.length <= MAX_CHUNK) {\n  return [{ json: { text: full } }];\n}\n\n// Split long transcriptions into multiple messages\nconst words = transcription.split(' ');\nconst chunks = [];\nlet current = '';\n\nfor (const word of words) {\n  if ((current + ' ' + word).length > MAX_CHUNK) {\n    if (current) chunks.push(current.trim());\n    current = word;\n  } else {\n    current += (current ? ' ' : '') + word;\n  }\n}\nif (current.trim()) chunks.push(current.trim());\n\nreturn chunks.map((chunk, i) => ({\n  json: {\n    text: (i === 0 ? header : `📝 *...parte ${i + 1}/${chunks.length}:*\\n\\n`) +\n          chunk +\n          (i === chunks.length - 1 ? footer : '')\n  }\n}));"
      },
      "id": "00000000-0000-0000-0000-000000000015",
      "name": "Formatear Transcripción",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1980, 220]
    },
